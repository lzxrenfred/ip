<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="420.0"
            style="-fx-background-color: #f4f4f4;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="larry.MainWindow">

    <top>
        <VBox spacing="4.0"
              style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="16.0" right="16.0" bottom="14.0" left="16.0"/>
            </padding>
            <Label text="Larry"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Your personal task manager"
                   style="-fx-text-fill: #666666;"/>
        </VBox>
    </top>

    <center>
        <TextArea fx:id="dialogArea"
                  editable="false"
                  focusTraversable="false"
                  wrapText="true"
                  style="-fx-font-size: 14px;">
            <BorderPane.margin>
                <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
            </BorderPane.margin>
        </TextArea>
    </center>

    <bottom>
        <HBox spacing="8.0"
              style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
            </padding>

            <TextField fx:id="userInput"
                       HBox.hgrow="ALWAYS"
                       onAction="#handleUserInput"
                       prefHeight="40.0"
                       promptText="Type a command..."/>

            <Button fx:id="sendButton"
                    mnemonicParsing="false"
                    onAction="#handleUserInput"
                    prefHeight="40.0"
                    prefWidth="72.0"
                    text="Send"
                    style="-fx-font-weight: bold;"/>
        </HBox>
    </bottom>

</BorderPane>
